# Meridian secrets — NOT committed to git, NOT readable by Claude Code.
# Fill in real values below. Add new keys here as needed.

# RocketRide
# Local (prerelease) — run your own local server; both devs share Meridian.pipe via git.
# ROCKETRIDE_URI and ROCKETRIDE_APIKEY are auto-written here by the VS Code
# extension settings — do not hand-edit those two.
# Vars referenced inside .pipe files MUST use the ROCKETRIDE_ prefix and the
# same names on both machines. Meridian.pipe references these three:
# ROCKETRIDE_NEBIUS_API_KEY=       # Nebius Token Factory key for the pipeline LLM (llama-3-3-70b)
# ROCKETRIDE_BUTTERBASE_API_BASE=  # Butterbase REST base URL, e.g. https://api.butterbase.ai/v1/<app> (no trailing slash)
# ROCKETRIDE_BUTTERBASE_API_KEY=   # Butterbase API key, sent by the agent as Authorization: Bearer <key>

# Butterbase
# Dashboard https://dashboard.butterbase.ai/
BUTTERBASE_APP_ID=
BUTTERBASE_API_KEY=

# XTrace
XTRACE_ORG_ID=
XTRACE_API_KEY=

# Photon (Slack integration)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

